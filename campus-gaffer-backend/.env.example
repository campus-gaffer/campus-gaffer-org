DATABASE_URL='postgresql://neondb_owner:password@localhost/neondb'
DATABASE_DEV_URL='postgresql://neondb_owner:password@localhost/neondb'
CLERK_ISSUER='https://your-clerk-domain.clerk.accounts.dev'
CLERK_SECRET_KEY='sk_test_your_clerk_secret_key'
USE_MOCK_SCRAPER=false
ApiTokenForSPA=your_api_token_here
ASPNET_SESSION_ID=your_session_id_here
LOCALSTACK_AUTH_TOKEN='your_localstack_auth_token_here'
LEAGUE_TZ='America/Winnipeg'
# Comma-separated origins allowed for CORS. No wildcards. API refuses to start if unset/empty.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://app.campusgaffer.example
